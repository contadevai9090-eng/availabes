<?xml version="1.0" encoding="UTF-8"?>
<layoutset>
	<widget name="PIXStoreConfirmRoot" type="frame" pos="0 0" size="1 1">
		<!-- Fundo escuro -->
		<widget name="DialogOverlay" type="ImageWidget" pos="0 0" size="1 1" color="0 0 0" alpha="0.7" />

		<!-- Caixa de dialogo -->
		<widget name="DialogBox" type="frame" pos="0.3 0.3" size="0.4 0.3">
			<widget name="DialogBG" type="ImageWidget" pos="0 0" size="1 1" color="0.1 0.1 0.1" alpha="0.95" />

			<!-- Borda superior verde -->
			<widget name="DialogBorder" type="ImageWidget" pos="0 0" size="1 0.04" color="0.1 0.6 0.1" alpha="1" />

			<!-- Titulo -->
			<widget name="ConfirmDialogTitle" type="TextWidget" pos="0.05 0.08" size="0.9 0.12" text="CONFIRMAR ACAO" font="gui/fonts/Roboto" fontsize="20" color="1 1 1" halign="center" />

			<!-- Mensagem -->
			<widget name="ConfirmDialogMessage" type="RichTextWidget" pos="0.05 0.25" size="0.9 0.2" text="" font="gui/fonts/Roboto" fontsize="14" color="0.8 0.8 0.8" halign="center" />

			<!-- Nome do item -->
			<widget name="ConfirmDialogItemName" type="TextWidget" pos="0.05 0.48" size="0.9 0.1" text="" font="gui/fonts/Roboto" fontsize="16" color="0.9 0.9 0.2" halign="center" />

			<!-- Botoes -->
			<widget name="btn_confirm_yes" type="ButtonWidget" pos="0.1 0.7" size="0.35 0.2" text="CONFIRMAR" font="gui/fonts/Roboto" fontsize="16" />
			<widget name="btn_confirm_no" type="ButtonWidget" pos="0.55 0.7" size="0.35 0.2" text="CANCELAR" font="gui/fonts/Roboto" fontsize="16" />
		</widget>
	</widget>
</layoutset>
